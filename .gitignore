# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# environment & secrets — never commit
.env
.env.local
.env.*
!.env.example

# private case files and uploaded documents (course materials / applicant data)
/data/**/*.pdf
/data/**/*.pptx
/data/**/*.docx
/data/**/*.xlsx
/data/**/*.csv
/data/private/
/uploads/
/storage/

# model files and local AI caches (none are used; guard anyway)
*.gguf
*.safetensors
*.bin
/models/
.ollama/

# local database files
*.db
*.sqlite
*.sqlite3
/supabase/.temp/
/supabase/.branches/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel
coverage/

# evaluation run artefacts (regenerate with npm run eval)
/evals/reports/
