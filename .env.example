# ---------------------------------------------------------------------------
# All In Capital — environment variables. Copy to .env.local for local overrides.
# The DEFAULT DEMO NEEDS NONE OF THESE: no AI key, no database, no paid service.
# ---------------------------------------------------------------------------

# Load the 10-application case batch on first visit (set "false" to start empty).
NEXT_PUBLIC_LOAD_CASE_SEED=true

# --- Production mode (Supabase) — not wired in the demo; see docs/DEPLOYMENT.md ---
# Public values (safe in the browser; RLS protects data):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_ and never import from client code:
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional future AI provider (disabled by default) ---
# Leave empty. Setting a key does NOT enable it: an admin opt-in and a privacy review are also required
# before any applicant document is sent to an external service.
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
